{
    "name": "andcreate/offset-pagination-for-wpgraphql",
    "description": "Adds offset pagination to WPGraphQL connections",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "AndCreate"
        },
        {
            "name": "Esa-Matti Suuronen",
            "email": "esa-matti.suuronen@valu.fi",
            "role": "original author"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "axepress/wp-graphql-stubs": "^2.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-graphql/wp-graphql-testcase": "^3.4",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/phpunit/includes/"
        ]
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "support": {
        "issues": "https://github.com/andcreate/offset-pagination-for-wpgraphql/issues",
        "source": "https://github.com/andcreate/offset-pagination-for-wpgraphql"
    }
}
